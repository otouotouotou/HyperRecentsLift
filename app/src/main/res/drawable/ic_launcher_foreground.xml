    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,24 L70,46 L38,46 Z" />
    <!-- 矢印の軸 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49,46 L59,46 L59,68 L49,68 Z" />
    <!-- 土台バー (画面の下端) -->
